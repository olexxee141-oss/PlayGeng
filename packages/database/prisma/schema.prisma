generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CommunityStatus {
  ACTIVE
  ARCHIVED
}

enum MatchStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum MatchParticipantStatus {
  CONFIRMED
  WAITLISTED
  DECLINED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  TREASURER
  ORGANIZER
  MEMBER
}

enum Sport {
  FOOTBALL
  BASKETBALL
  VOLLEYBALL
  TENNIS
  TABLE_TENNIS
  BADMINTON
  CRICKET
  RUGBY
  ESPORTS
  OTHER
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum TeamMemberRole {
  CAPTAIN
  COACH
  PLAYER
}

enum CompetitionFormat {
  ROUND_ROBIN
  KNOCKOUT
}

enum CompetitionParticipantType {
  TEAM
  PLAYER
}

enum CompetitionRegistrationMode {
  OPEN
  APPROVAL_REQUIRED
  INVITE_ONLY
}

enum CompetitionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CompetitionEntryStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CompetitionInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum CompetitionFixtureStatus {
  SCHEDULED
  BYE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique @db.VarChar(320)
  firstName                String                  @db.VarChar(80)
  lastName                 String                  @db.VarChar(80)
  passwordHash             String                  @db.VarChar(255)
  status                   UserStatus              @default(ACTIVE)
  emailVerifiedAt          DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  sessions                 AuthSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  communitiesOwned         Community[]            @relation("CommunityOwner")
  communityMemberships     CommunityMember[]
  createdMatches          Match[]                 @relation("MatchCreator")
  matchParticipations     MatchParticipant[]
  teamMemberships         TeamMember[]
  createdTeams            Team[]                 @relation("TeamCreator")
  createdCompetitions     Competition[]          @relation("CompetitionCreator")
  reviewedCompetitionEntries CompetitionEntry[]   @relation("CompetitionEntryReviewer")
  competitionEntries        CompetitionEntry[]   @relation("CompetitionPlayer")
  sentCompetitionInvitations CompetitionInvitation[] @relation("CompetitionInvitationSender")
  receivedCompetitionInvitations CompetitionInvitation[] @relation("CompetitionInvitationRecipient")
  invitedPlayerCompetitionInvitations CompetitionInvitation[] @relation("CompetitionInvitationPlayer")
  createdCompetitionSchedules CompetitionSchedule[] @relation("CompetitionScheduleCreator")

  @@index([status])
  @@map("users")
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique @db.VarChar(128)
  userAgent    String?   @db.VarChar(512)
  ipAddress    String?   @db.VarChar(64)
  expiresAt    DateTime
  lastUsedAt   DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique @db.VarChar(128)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique @db.VarChar(128)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Community {
  id          String          @id @default(cuid())
  name        String          @db.VarChar(120)
  slug        String          @unique @db.VarChar(140)
  description String?         @db.VarChar(1000)
  sport       String          @default("FOOTBALL") @db.VarChar(50)
  status      CommunityStatus @default(ACTIVE)
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner       User             @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     CommunityMember[]
  matches     Match[]
  sports      CommunitySport[]
  teams       Team[]
  competitions Competition[]
  competitionEntries CompetitionEntry[]
  competitionInvitations CompetitionInvitation[]

  @@index([ownerId])
  @@index([status])
  @@map("communities")
}

model CommunityMember {
  id          String              @id @default(cuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  community   Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  teamMemberships TeamMember[]
  @@index([userId])
  @@index([communityId, role])
  @@map("community_members")
}


model CommunitySport {
  id          String   @id @default(cuid())
  communityId String
  sport       Sport
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  teams     Team[]
  competitions Competition[]

  @@unique([communityId, sport])
  @@unique([id, communityId])
  @@index([communityId, isPrimary])
  @@map("community_sports")
}

model Team {
  id               String     @id @default(cuid())
  communityId      String
  communitySportId String
  name             String     @db.VarChar(100)
  shortName        String?    @db.VarChar(20)
  description      String?    @db.VarChar(500)
  status           TeamStatus @default(ACTIVE)
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User            @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sport     CommunitySport @relation(fields: [communitySportId, communityId], references: [id, communityId], onDelete: Restrict)
  members   TeamMember[]
  competitionEntries CompetitionEntry[]
  competitionInvitations CompetitionInvitation[]

  @@unique([id, communityId])
  @@unique([communityId, name])
  @@index([communityId, status])
  @@index([communitySportId, status])
  @@map("teams")
}

model TeamMember {
  id          String         @id @default(cuid())
  communityId String
  teamId      String
  userId      String
  role        TeamMemberRole @default(PLAYER)
  captainKey  String?        @db.VarChar(16)
  joinedAt    DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  team Team            @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Cascade)
  member CommunityMember @relation(fields: [communityId, userId], references: [communityId, userId], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([teamId, captainKey])
  @@index([communityId, userId])
  @@index([userId, joinedAt])
  @@map("team_members")
}


model Match {
  id          String       @id @default(cuid())
  communityId String
  createdById String
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(1000)
  sport       String       @db.VarChar(50)
  venue       String?      @db.VarChar(200)
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int?
  status      MatchStatus  @default(SCHEDULED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  community    Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("MatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants MatchParticipant[]

  @@index([communityId, startsAt])
  @@index([communityId, status, startsAt])
  @@index([createdById])
  @@map("matches")
}

model MatchParticipant {
  id        String                 @id @default(cuid())
  matchId   String
  userId    String
  status    MatchParticipantStatus @default(CONFIRMED)
  joinedAt  DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId, status])
  @@index([userId, joinedAt])
  @@map("match_participants")
}


model Competition {
  id                    String                       @id @default(cuid())
  communityId           String
  communitySportId      String
  createdById           String
  name                  String                       @db.VarChar(140)
  description           String?                      @db.VarChar(2000)
  format                CompetitionFormat
  participantType       CompetitionParticipantType
  registrationMode      CompetitionRegistrationMode  @default(APPROVAL_REQUIRED)
  status                CompetitionStatus            @default(DRAFT)
  maxEntries            Int?
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  startsAt              DateTime?
  rulesetVersion        String                       @default("1") @db.VarChar(32)
  adapterVersion        String                       @default("1") @db.VarChar(32)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  community       Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sport           CommunitySport @relation(fields: [communitySportId, communityId], references: [id, communityId], onDelete: Restrict)
  createdBy       User           @relation("CompetitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  entries         CompetitionEntry[]
  invitations     CompetitionInvitation[]
  schedule        CompetitionSchedule?
  fixtures        CompetitionFixture[]

  @@unique([id, communityId])
  @@unique([id, communityId, participantType])
  @@index([communityId, status, startsAt])
  @@index([communitySportId, status])
  @@map("competitions")
}

model CompetitionEntry {
  id                    String                    @id @default(cuid())
  competitionId         String
  communityId           String
  participantType       CompetitionParticipantType
  teamId                String?
  playerUserId          String?
  seed                  Int?
  status                CompetitionEntryStatus    @default(PENDING)
  participantNameSnapshot String                   @db.VarChar(160)
  registeredAt          DateTime                  @default(now())
  reviewedAt            DateTime?
  reviewedById          String?
  rejectionReason       String?                    @db.VarChar(500)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId, communityId, participantType], references: [id, communityId, participantType], onDelete: Cascade)
  fixturesAsA CompetitionFixture[] @relation("FixtureParticipantA")
  fixturesAsB CompetitionFixture[] @relation("FixtureParticipantB")
  fixturesWon CompetitionFixture[] @relation("FixtureWinner")
  team        Team?       @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Restrict)
  player      User?       @relation("CompetitionPlayer", fields: [playerUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("CompetitionEntryReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([id, competitionId])
  @@index([competitionId, status, registeredAt])
  @@index([communityId, playerUserId])
  @@map("competition_entries")
}


model CompetitionInvitation {
  id              String                      @id @default(cuid())
  competitionId   String
  communityId     String
  participantType CompetitionParticipantType
  teamId          String?
  playerUserId    String?
  invitedUserId   String
  invitedById     String
  status          CompetitionInvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId, communityId, participantType], references: [id, communityId, participantType], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Restrict)
  player      User?       @relation("CompetitionInvitationPlayer", fields: [playerUserId], references: [id], onDelete: Restrict)
  invitedUser User        @relation("CompetitionInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Restrict)
  invitedBy   User        @relation("CompetitionInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([competitionId, status, expiresAt])
  @@index([communityId, invitedUserId, status])
  @@map("competition_invitations")
}


model CompetitionSchedule {
  id               String          @id @default(cuid())
  competitionId    String          @unique
  createdById      String
  format           CompetitionFormat
  algorithmVersion String          @db.VarChar(32)
  participantCount Int
  roundCount       Int
  fixtureCount     Int
  matchCount       Int
  byeCount         Int
  orderedEntryIds  Json
  generatedAt      DateTime        @default(now())
  createdAt        DateTime        @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("CompetitionScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  fixtures    CompetitionFixture[]

  @@unique([id, competitionId])
  @@map("competition_schedules")
}

model CompetitionFixture {
  id                    String                  @id @default(cuid())
  scheduleId            String
  competitionId         String
  roundNumber           Int
  fixtureNumber         Int
  participantAEntryId   String
  participantBEntryId   String?
  winnerEntryId         String?
  status                CompetitionFixtureStatus @default(SCHEDULED)
  scheduledAt           DateTime?
  venue                 String?                 @db.VarChar(200)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  schedule      CompetitionSchedule @relation(fields: [scheduleId, competitionId], references: [id, competitionId], onDelete: Cascade)
  competition   Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participantA  CompetitionEntry    @relation("FixtureParticipantA", fields: [participantAEntryId, competitionId], references: [id, competitionId], onDelete: Restrict)
  participantB  CompetitionEntry?   @relation("FixtureParticipantB", fields: [participantBEntryId, competitionId], references: [id, competitionId], onDelete: Restrict)
  winner        CompetitionEntry?   @relation("FixtureWinner", fields: [winnerEntryId, competitionId], references: [id, competitionId], onDelete: Restrict)

  @@unique([scheduleId, roundNumber, fixtureNumber])
  @@index([competitionId, roundNumber, fixtureNumber])
  @@index([competitionId, status])
  @@map("competition_fixtures")
}
