generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CommunityStatus {
  ACTIVE
  ARCHIVED
}

enum MatchStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum MatchParticipantStatus {
  CONFIRMED
  WAITLISTED
  DECLINED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  TREASURER
  ORGANIZER
  MEMBER
}

enum Sport {
  FOOTBALL
  BASKETBALL
  VOLLEYBALL
  TENNIS
  TABLE_TENNIS
  BADMINTON
  CRICKET
  RUGBY
  ESPORTS
  OTHER
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum TeamMemberRole {
  CAPTAIN
  COACH
  PLAYER
}

enum CompetitionFormat {
  ROUND_ROBIN
  KNOCKOUT
}

enum CompetitionParticipantType {
  TEAM
  PLAYER
}

enum CompetitionRegistrationMode {
  OPEN
  APPROVAL_REQUIRED
  INVITE_ONLY
}

enum CompetitionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CompetitionEntryStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique @db.VarChar(320)
  firstName                String                  @db.VarChar(80)
  lastName                 String                  @db.VarChar(80)
  passwordHash             String                  @db.VarChar(255)
  status                   UserStatus              @default(ACTIVE)
  emailVerifiedAt          DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  sessions                 AuthSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  communitiesOwned         Community[]            @relation("CommunityOwner")
  communityMemberships     CommunityMember[]
  createdMatches          Match[]                 @relation("MatchCreator")
  matchParticipations     MatchParticipant[]
  teamMemberships         TeamMember[]
  createdTeams            Team[]                 @relation("TeamCreator")

  @@index([status])
  @@map("users")
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique @db.VarChar(128)
  userAgent    String?   @db.VarChar(512)
  ipAddress    String?   @db.VarChar(64)
  expiresAt    DateTime
  lastUsedAt   DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique @db.VarChar(128)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique @db.VarChar(128)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Community {
  id          String          @id @default(cuid())
  name        String          @db.VarChar(120)
  slug        String          @unique @db.VarChar(140)
  description String?         @db.VarChar(1000)
  sport       String          @default("FOOTBALL") @db.VarChar(50)
  status      CommunityStatus @default(ACTIVE)
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner       User             @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     CommunityMember[]
  matches     Match[]
  sports      CommunitySport[]
  teams       Team[]
  competitions Competition[]
  competitionEntries CompetitionEntry[]

  @@index([ownerId])
  @@index([status])
  @@map("communities")
}

model CommunityMember {
  id          String              @id @default(cuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  community   Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  teamMemberships TeamMember[]
  competitionEntries CompetitionEntry[]
  @@index([userId])
  @@index([communityId, role])
  @@map("community_members")
}


model CommunitySport {
  id          String   @id @default(cuid())
  communityId String
  sport       Sport
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  teams     Team[]
  competitions Competition[]

  @@unique([communityId, sport])
  @@unique([id, communityId])
  @@index([communityId, isPrimary])
  @@map("community_sports")
}

model Team {
  id               String     @id @default(cuid())
  communityId      String
  communitySportId String
  name             String     @db.VarChar(100)
  shortName        String?    @db.VarChar(20)
  description      String?    @db.VarChar(500)
  status           TeamStatus @default(ACTIVE)
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User            @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sport     CommunitySport @relation(fields: [communitySportId, communityId], references: [id, communityId], onDelete: Restrict)
  members   TeamMember[]
  competitionEntries CompetitionEntry[]

  @@unique([id, communityId])
  @@unique([communityId, name])
  @@index([communityId, status])
  @@index([communitySportId, status])
  @@map("teams")
}

model TeamMember {
  id          String         @id @default(cuid())
  communityId String
  teamId      String
  userId      String
  role        TeamMemberRole @default(PLAYER)
  captainKey  String?        @db.VarChar(16)
  joinedAt    DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  team Team            @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Cascade)
  member CommunityMember @relation(fields: [communityId, userId], references: [communityId, userId], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([teamId, captainKey])
  @@index([communityId, userId])
  @@index([userId, joinedAt])
  @@map("team_members")
}


model Match {
  id          String       @id @default(cuid())
  communityId String
  createdById String
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(1000)
  sport       String       @db.VarChar(50)
  venue       String?      @db.VarChar(200)
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int?
  status      MatchStatus  @default(SCHEDULED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  community    Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("MatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants MatchParticipant[]

  @@index([communityId, startsAt])
  @@index([communityId, status, startsAt])
  @@index([createdById])
  @@map("matches")
}

model MatchParticipant {
  id        String                 @id @default(cuid())
  matchId   String
  userId    String
  status    MatchParticipantStatus @default(CONFIRMED)
  joinedAt  DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId, status])
  @@index([userId, joinedAt])
  @@map("match_participants")
}


model Competition {
  id                    String                       @id @default(cuid())
  communityId           String
  communitySportId      String
  createdById           String
  name                  String                       @db.VarChar(140)
  description           String?                      @db.VarChar(2000)
  format                CompetitionFormat
  participantType       CompetitionParticipantType
  registrationMode      CompetitionRegistrationMode  @default(APPROVAL_REQUIRED)
  status                CompetitionStatus            @default(DRAFT)
  maxEntries            Int?
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  startsAt              DateTime?
  rulesetVersion        String                       @default("1") @db.VarChar(32)
  adapterVersion        String                       @default("1") @db.VarChar(32)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  community       Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sport           CommunitySport @relation(fields: [communitySportId, communityId], references: [id, communityId], onDelete: Restrict)
  createdBy       User           @relation("CompetitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  entries         CompetitionEntry[]

  @@unique([id, communityId])
  @@unique([id, communityId, participantType])
  @@index([communityId, status, startsAt])
  @@index([communitySportId, status])
  @@map("competitions")
}

model CompetitionEntry {
  id                    String                    @id @default(cuid())
  competitionId         String
  communityId           String
  participantType       CompetitionParticipantType
  teamId                String?
  playerUserId          String?
  status                CompetitionEntryStatus    @default(PENDING)
  participantNameSnapshot String                   @db.VarChar(160)
  registeredAt          DateTime                  @default(now())
  reviewedAt            DateTime?
  reviewedById          String?
  rejectionReason       String?                    @db.VarChar(500)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  competition Competition @relation(fields: [competitionId, communityId, participantType], references: [id, communityId, participantType], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Restrict)
  player      CommunityMember? @relation(fields: [communityId, playerUserId], references: [communityId, userId], onDelete: Restrict)
  reviewedBy  User?       @relation("CompetitionEntryReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([competitionId, teamId])
  @@unique([competitionId, playerUserId])
  @@index([competitionId, status, registeredAt])
  @@index([communityId, playerUserId])
  @@map("competition_entries")
}
