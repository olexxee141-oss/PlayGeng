generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum TreasuryAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}
enum JournalTransactionType {
  OPENING_BALANCE
  OBLIGATION_ISSUED
  PAYMENT_RECEIVED
  CONTRIBUTION_RECEIVED
  EXPENSE_PAID
  REFUND
  ADJUSTMENT
  REVERSAL
}
enum JournalTransactionStatus {
  DRAFT
  POSTED
}
enum LedgerPostingSide {
  DEBIT
  CREDIT
}
enum ObligationSourceType {
  CONTRIBUTION
  MATCH_FEE
  COMPETITION_FEE
  OTHER
}
enum ObligationStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ContributionFrequency {
  ONE_OFF
  MONTHLY
}

enum ContributionAssessmentGenerationMode {
  AUTOMATIC
  MANUAL
}

enum ContributionCampaignStatus {
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum ContributionAssessmentStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum AssemblyCaseStatus {
  SUBMITTED
  WITHDRAWN
}

enum AssemblyCaseEventType {
  SUBMITTED
  WITHDRAWN
  CONFLICT_REVIEW_STARTED
  ELECTORATE_FROZEN
}

enum AssemblyConflictDeclarationStatus {
  OPEN
  WITHDRAWN
  CONFLICT_CONFIRMED
  NO_CONFLICT
}

enum ContributionCampaignEventType {
  PAUSED
  RESUMED
  ENDED
  CANCELLED
}

enum ReceiptSource {
  MANUAL_RECONCILIATION
  PROVIDER_SETTLEMENT
}

enum FinancialProviderStatus {
  ACTIVE
  DISABLED
}

enum FinancialCollectionStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ProviderEventStatus {
  RECEIVED
  VALIDATED
  REJECTED
  PROCESSED
  FAILED
}

enum FinancialSettlementStatus {
  PENDING
  SETTLED
  FAILED
  RECONCILIATION_REQUIRED
}

enum FinancialReconciliationStatus {
  OPEN
  MATCHED
  DISCREPANCY
  RESOLVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CommunityStatus {
  ACTIVE
  ARCHIVED
}

enum MatchStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum MatchParticipantStatus {
  CONFIRMED
  WAITLISTED
  DECLINED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum CommunityMemberRole {
  CREATOR
  ADMIN
  TREASURER
  ORGANIZER
  MEMBER
}

enum ElectionRole {
  ADMIN
  TREASURER
  ORGANIZER
}

enum ElectionStatus {
  NOMINATIONS_OPEN
  NOMINATIONS_CLOSED
  VOTING_OPEN
  COMPLETED
  FAILED
  CANCELLED
}

enum ReviewCouncilSeat {
  PRIMARY
  ALTERNATE
}

enum ReviewCouncilMembershipStatus {
  ACTIVE
  RESIGNED
  RECALLED
  ENDED
}

enum Sport {
  FOOTBALL
  BASKETBALL
  VOLLEYBALL
  TENNIS
  TABLE_TENNIS
  BADMINTON
  CRICKET
  RUGBY
  ESPORTS
  OTHER
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum TeamMemberRole {
  CAPTAIN
  COACH
  PLAYER
}

enum CompetitionFormat {
  ROUND_ROBIN
  KNOCKOUT
}

enum CompetitionParticipantType {
  TEAM
  PLAYER
}

enum CompetitionRegistrationMode {
  OPEN
  APPROVAL_REQUIRED
  INVITE_ONLY
}

enum CompetitionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CompetitionEntryStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CompetitionInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum CompetitionFixtureStatus {
  SCHEDULED
  BYE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique @db.VarChar(320)
  firstName                String                  @db.VarChar(80)
  lastName                 String                  @db.VarChar(80)
  passwordHash             String                  @db.VarChar(255)
  status                   UserStatus              @default(ACTIVE)
  emailVerifiedAt          DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  sessions                 AuthSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  communitiesOwned         Community[]            @relation("CommunityOwner")
  communityMemberships     CommunityMember[]
  createdMatches          Match[]                 @relation("MatchCreator")
  matchParticipations     MatchParticipant[]
  teamMemberships         TeamMember[]
  createdTeams            Team[]                 @relation("TeamCreator")
  createdCompetitions     Competition[]          @relation("CompetitionCreator")
  createdCompetitionSchedules CompetitionSchedule[] @relation("CompetitionScheduleCreator")
  reviewedCompetitionEntries CompetitionEntry[]   @relation("CompetitionEntryReviewer")
  competitionEntries        CompetitionEntry[]   @relation("CompetitionPlayer")
  sentCompetitionInvitations CompetitionInvitation[] @relation("CompetitionInvitationSender")
  receivedCompetitionInvitations CompetitionInvitation[] @relation("CompetitionInvitationRecipient")
  invitedPlayerCompetitionInvitations CompetitionInvitation[] @relation("CompetitionInvitationPlayer")
  createdCommunityElections CommunityElection[] @relation("ElectionCreator")
  wonCommunityElections CommunityElection[] @relation("ElectionWinner")
  eligibleElectionVotes ElectionEligibleVoter[]
  electionNominations ElectionNomination[]
  electionBallots ElectionBallot[] @relation("ElectionVoter")
  createdReviewCouncilElections CommunityReviewCouncilElection[] @relation("ReviewCouncilElectionCreator")
  wonReviewCouncilElections CommunityReviewCouncilElection[] @relation("ReviewCouncilElectionWinner")
  eligibleReviewCouncilVotes ReviewCouncilEligibleVoter[]
  reviewCouncilNominations ReviewCouncilNomination[]
  reviewCouncilBallots ReviewCouncilBallot[] @relation("ReviewCouncilVoter")
  reviewCouncilMemberships ReviewCouncilMember[]
  createdTreasuries Treasury[] @relation("TreasuryCreator")
  createdJournalTransactions JournalTransaction[] @relation("JournalActor")
  createdObligations Obligation[] @relation("ObligationActor")
  memberObligations Obligation[] @relation("ObligationMember")
  createdContributionCampaigns ContributionCampaign[] @relation("ContributionCampaignCreator")
  contributionCampaignEvents ContributionCampaignEvent[]
  createdContributionAssessments ContributionAssessment[] @relation("ContributionAssessmentCreator")
  issuedContributionAssessments ContributionAssessment[] @relation("ContributionAssessmentIssuer")
  cancelledContributionAssessments ContributionAssessment[] @relation("ContributionAssessmentCanceller")
  contributionAssessmentSnapshots ContributionAssessmentMember[]
  requestedAssemblyCases AssemblyCase[] @relation("AssemblyCaseRequester")
  assemblyCaseEvents AssemblyCaseEvent[] @relation("AssemblyCaseEventActor")
  declaredAssemblyConflicts AssemblyConflictDeclaration[] @relation("AssemblyConflictDeclarant")
  subjectOfAssemblyConflicts AssemblyConflictDeclaration[] @relation("AssemblyConflictSubject")
  reviewedAssemblyConflictDecisions AssemblyConflictDecision[]
  assemblyCaseElectorateMemberships AssemblyCaseElectorateMember[]
  financialAuditEvents FinancialAuditEvent[] @relation("FinancialAuditActor")
  verifiedReceipts PaymentReceipt[] @relation("ReceiptVerifier")
  memberReceipts PaymentReceipt[] @relation("ReceiptMember")
  createdAllocations ObligationAllocation[] @relation("AllocationActor")
  financialCollections FinancialCollection[] @relation("FinancialCollectionMember")
  createdFinancialCollections FinancialCollection[] @relation("FinancialCollectionCreator")

  @@index([status])
  @@map("users")
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique @db.VarChar(128)
  userAgent    String?   @db.VarChar(512)
  ipAddress    String?   @db.VarChar(64)
  expiresAt    DateTime
  lastUsedAt   DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique @db.VarChar(128)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique @db.VarChar(128)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Community {
  id          String          @id @default(cuid())
  name        String          @db.VarChar(120)
  slug        String          @unique @db.VarChar(140)
  description String?         @db.VarChar(1000)
  sport       String          @default("FOOTBALL") @db.VarChar(50)
  status      CommunityStatus @default(ACTIVE)
  timezone    String          @default("UTC") @db.VarChar(64)
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner       User             @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     CommunityMember[]
  matches     Match[]
  sports      CommunitySport[]
  teams       Team[]
  competitions Competition[]
  competitionEntries CompetitionEntry[]
  competitionInvitations CompetitionInvitation[]
  elections CommunityElection[]
  reviewCouncilElections CommunityReviewCouncilElection[]
  reviewCouncilMemberships ReviewCouncilMember[]
  treasury Treasury?
  contributionCampaigns ContributionCampaign[]
  contributionAssessments ContributionAssessment[]
  assemblyCases AssemblyCase[]

  @@index([ownerId])
  @@index([status])
  @@map("communities")
}

model CommunityMember {
  id          String              @id @default(cuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  community   Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  teamMemberships TeamMember[]
  @@index([userId])
  @@index([communityId, role])
  @@map("community_members")
}


model CommunitySport {
  id          String   @id @default(cuid())
  communityId String
  sport       Sport
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  teams     Team[]
  competitions Competition[]

  @@unique([communityId, sport])
  @@unique([id, communityId])
  @@index([communityId, isPrimary])
  @@map("community_sports")
}

model Team {
  id               String     @id @default(cuid())
  communityId      String
  communitySportId String
  name             String     @db.VarChar(100)
  shortName        String?    @db.VarChar(20)
  description      String?    @db.VarChar(500)
  status           TeamStatus @default(ACTIVE)
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User            @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sport     CommunitySport @relation(fields: [communitySportId, communityId], references: [id, communityId], onDelete: Restrict)
  members   TeamMember[]
  competitionEntries CompetitionEntry[]
  competitionInvitations CompetitionInvitation[]

  @@unique([id, communityId])
  @@unique([communityId, name])
  @@index([communityId, status])
  @@index([communitySportId, status])
  @@map("teams")
}

model TeamMember {
  id          String         @id @default(cuid())
  communityId String
  teamId      String
  userId      String
  role        TeamMemberRole @default(PLAYER)
  captainKey  String?        @db.VarChar(16)
  joinedAt    DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  team Team            @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Cascade)
  member CommunityMember @relation(fields: [communityId, userId], references: [communityId, userId], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([teamId, captainKey])
  @@index([communityId, userId])
  @@index([userId, joinedAt])
  @@map("team_members")
}


model Match {
  id          String       @id @default(cuid())
  communityId String
  createdById String
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(1000)
  sport       String       @db.VarChar(50)
  venue       String?      @db.VarChar(200)
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int?
  status      MatchStatus  @default(SCHEDULED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  community    Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("MatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants MatchParticipant[]

  @@index([communityId, startsAt])
  @@index([communityId, status, startsAt])
  @@index([createdById])
  @@map("matches")
}

model MatchParticipant {
  id        String                 @id @default(cuid())
  matchId   String
  userId    String
  status    MatchParticipantStatus @default(CONFIRMED)
  joinedAt  DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId, status])
  @@index([userId, joinedAt])
  @@map("match_participants")
}


model Competition {
  id                    String                       @id @default(cuid())
  communityId           String
  communitySportId      String
  createdById           String
  name                  String                       @db.VarChar(140)
  description           String?                      @db.VarChar(2000)
  format                CompetitionFormat
  participantType       CompetitionParticipantType
  registrationMode      CompetitionRegistrationMode  @default(APPROVAL_REQUIRED)
  status                CompetitionStatus            @default(DRAFT)
  maxEntries            Int?
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  startsAt              DateTime?
  rulesetVersion        String                       @default("1") @db.VarChar(32)
  adapterVersion        String                       @default("1") @db.VarChar(32)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  community       Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sport           CommunitySport @relation(fields: [communitySportId, communityId], references: [id, communityId], onDelete: Restrict)
  createdBy       User           @relation("CompetitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  entries         CompetitionEntry[]
  invitations     CompetitionInvitation[]
  schedule        CompetitionSchedule?
  fixtures        CompetitionFixture[]

  @@unique([id, communityId])
  @@unique([id, communityId, participantType])
  @@unique([id, format])
  @@index([communityId, status, startsAt])
  @@index([communitySportId, status])
  @@map("competitions")
}

model CompetitionEntry {
  id                    String                    @id @default(cuid())
  competitionId         String
  communityId           String
  participantType       CompetitionParticipantType
  teamId                String?
  playerUserId          String?
  seed                  Int?
  status                CompetitionEntryStatus    @default(PENDING)
  participantNameSnapshot String                   @db.VarChar(160)
  registeredAt          DateTime                  @default(now())
  reviewedAt            DateTime?
  reviewedById          String?
  rejectionReason       String?                    @db.VarChar(500)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId, communityId, participantType], references: [id, communityId, participantType], onDelete: Cascade)
  fixturesAsA CompetitionFixture[] @relation("FixtureParticipantA")
  fixturesAsB CompetitionFixture[] @relation("FixtureParticipantB")
  fixturesWon CompetitionFixture[] @relation("FixtureWinner")
  team        Team?       @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Restrict)
  player      User?       @relation("CompetitionPlayer", fields: [playerUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("CompetitionEntryReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([id, competitionId])
  @@index([competitionId, status, registeredAt])
  @@index([communityId, playerUserId])
  @@map("competition_entries")
}


model CompetitionSchedule {
  id               String             @id @default(cuid())
  competitionId    String             @unique
  createdById      String
  format           CompetitionFormat
  algorithmVersion String             @db.VarChar(32)
  participantCount Int
  roundCount       Int
  fixtureCount     Int
  matchCount       Int
  byeCount         Int
  orderedEntryIds  Json
  generatedAt      DateTime           @default(now())
  createdAt        DateTime           @default(now())

  competition Competition          @relation(fields: [competitionId, format], references: [id, format], onDelete: Cascade)
  createdBy   User                 @relation("CompetitionScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  fixtures    CompetitionFixture[]

  @@unique([competitionId, format])
  @@unique([id, competitionId])
  @@map("competition_schedules")
}

model CompetitionFixture {
  id                  String                   @id @default(cuid())
  scheduleId          String
  competitionId       String
  roundNumber         Int
  fixtureNumber       Int
  participantAEntryId String
  participantBEntryId String?
  winnerEntryId       String?
  byeAdvances         Boolean                  @default(false)
  status              CompetitionFixtureStatus @default(SCHEDULED)
  scheduledAt         DateTime?
  venue               String?                  @db.VarChar(200)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  schedule     CompetitionSchedule @relation(fields: [scheduleId, competitionId], references: [id, competitionId], onDelete: Cascade)
  competition  Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participantA CompetitionEntry    @relation("FixtureParticipantA", fields: [participantAEntryId, competitionId], references: [id, competitionId], onDelete: Cascade)
  participantB CompetitionEntry?   @relation("FixtureParticipantB", fields: [participantBEntryId, competitionId], references: [id, competitionId], onDelete: Cascade)
  winner       CompetitionEntry?   @relation("FixtureWinner", fields: [winnerEntryId, competitionId], references: [id, competitionId], onDelete: Cascade)

  @@unique([scheduleId, roundNumber, fixtureNumber])
  @@index([competitionId, roundNumber, fixtureNumber])
  @@index([competitionId, status])
  @@map("competition_fixtures")
}


model CompetitionInvitation {
  id              String                      @id @default(cuid())
  competitionId   String
  communityId     String
  participantType CompetitionParticipantType
  teamId          String?
  playerUserId    String?
  invitedUserId   String
  invitedById     String
  status          CompetitionInvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId, communityId, participantType], references: [id, communityId, participantType], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Restrict)
  player      User?       @relation("CompetitionInvitationPlayer", fields: [playerUserId], references: [id], onDelete: Restrict)
  invitedUser User        @relation("CompetitionInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Restrict)
  invitedBy   User        @relation("CompetitionInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([competitionId, status, expiresAt])
  @@index([communityId, invitedUserId, status])
  @@map("competition_invitations")
}


model CommunityElection {
  id                 String         @id @default(cuid())
  communityId        String
  role               ElectionRole
  status             ElectionStatus @default(NOMINATIONS_OPEN)
  createdById        String
  nominationsCloseAt DateTime
  votingOpensAt      DateTime
  votingClosesAt     DateTime
  quorumPercent      Int
  eligibleVoterCount Int
  votesCast          Int            @default(0)
  winnerId           String?
  failureReason      String?        @db.VarChar(300)
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  community  Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy  User                  @relation("ElectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  winner     User?                 @relation("ElectionWinner", fields: [winnerId], references: [id], onDelete: Restrict)
  electorate ElectionEligibleVoter[]
  nominations ElectionNomination[]
  ballots    ElectionBallot[]

  @@index([communityId, status, role])
  @@index([communityId, createdAt])
  @@map("community_elections")
}

model CommunityReviewCouncilElection {
  id                 String         @id @default(cuid())
  communityId        String
  seatNumber         Int
  seat               ReviewCouncilSeat
  alternateRank      Int?
  status             ElectionStatus @default(NOMINATIONS_OPEN)
  createdById        String
  nominationsCloseAt DateTime
  votingOpensAt      DateTime
  votingClosesAt     DateTime
  quorumPercent      Int
  eligibleVoterCount Int
  votesCast          Int            @default(0)
  winnerId           String?
  failureReason      String?        @db.VarChar(300)
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  community  Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("ReviewCouncilElectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  winner     User?     @relation("ReviewCouncilElectionWinner", fields: [winnerId], references: [id], onDelete: Restrict)
  electorate ReviewCouncilEligibleVoter[]
  nominations ReviewCouncilNomination[]
  ballots    ReviewCouncilBallot[]
  membership ReviewCouncilMember?

  @@index([communityId, status, seatNumber])
  @@index([communityId, createdAt])
  @@map("community_review_council_elections")
}

model ReviewCouncilEligibleVoter {
  id         String   @id @default(cuid())
  electionId String
  userId     String
  snapshotAt DateTime @default(now())

  election CommunityReviewCouncilElection @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([electionId, userId])
  @@index([userId, electionId])
  @@map("review_council_eligible_voters")
}

model ReviewCouncilNomination {
  id          String    @id @default(cuid())
  electionId  String
  userId      String
  createdAt   DateTime  @default(now())
  withdrawnAt DateTime?

  election CommunityReviewCouncilElection @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ballots  ReviewCouncilBallot[]

  @@unique([electionId, userId])
  @@unique([id, electionId])
  @@index([electionId, withdrawnAt])
  @@map("review_council_nominations")
}

model ReviewCouncilBallot {
  id          String   @id @default(cuid())
  electionId  String
  voterId     String
  candidateId String
  castAt      DateTime @default(now())

  election  CommunityReviewCouncilElection @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voter     User                          @relation("ReviewCouncilVoter", fields: [voterId], references: [id], onDelete: Cascade)
  candidate ReviewCouncilNomination       @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Cascade)

  @@unique([electionId, voterId])
  @@index([electionId, candidateId])
  @@map("review_council_ballots")
}

model ReviewCouncilMember {
  id            String                       @id @default(cuid())
  communityId   String
  userId        String
  electionId    String                       @unique
  seatNumber    Int
  seat          ReviewCouncilSeat
  alternateRank Int?
  status        ReviewCouncilMembershipStatus @default(ACTIVE)
  termStartsAt  DateTime
  termEndsAt    DateTime
  endedAt       DateTime?
  endReason     String?                      @db.VarChar(300)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  community Community                       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  election  CommunityReviewCouncilElection  @relation(fields: [electionId], references: [id], onDelete: Restrict)

  @@index([communityId, status, seat, alternateRank])
  @@index([communityId, termEndsAt])
  @@map("review_council_members")
}

model ElectionEligibleVoter {
  id         String   @id @default(cuid())
  electionId String
  userId     String
  snapshotAt DateTime @default(now())

  election CommunityElection @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([electionId, userId])
  @@index([userId, electionId])
  @@map("election_eligible_voters")
}

model ElectionNomination {
  id          String    @id @default(cuid())
  electionId  String
  userId      String
  createdAt   DateTime  @default(now())
  withdrawnAt DateTime?

  election CommunityElection @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ballots  ElectionBallot[]

  @@unique([electionId, userId])
  @@unique([id, electionId])
  @@index([electionId, withdrawnAt])
  @@map("election_nominations")
}

model ElectionBallot {
  id          String   @id @default(cuid())
  electionId  String
  voterId     String
  candidateId String
  castAt      DateTime @default(now())

  election CommunityElection @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voter    User              @relation("ElectionVoter", fields: [voterId], references: [id], onDelete: Cascade)
  candidate ElectionNomination @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Cascade)

  @@unique([electionId, voterId])
  @@index([electionId, candidateId])
  @@map("election_ballots")
}


model Treasury {
  id          String   @id @default(cuid())
  communityId String   @unique
  createdById String
  currency    String   @db.Char(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  createdBy User @relation("TreasuryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  accounts TreasuryAccount[]
  journalTransactions JournalTransaction[]
  obligations Obligation[]
  auditEvents FinancialAuditEvent[]
  receipts PaymentReceipt[]
  allocations ObligationAllocation[]
  financialCollections FinancialCollection[]
  @@map("treasuries")
}

model TreasuryAccount {
  id String @id @default(cuid())
  treasuryId String
  code String @db.VarChar(32)
  name String @db.VarChar(100)
  type TreasuryAccountType
  isSystem Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  postings LedgerPosting[]
  @@unique([treasuryId, code])
  @@unique([id, treasuryId])
  @@index([treasuryId, type, isActive])
  @@map("treasury_accounts")
}

model JournalTransaction {
  id String @id @default(cuid())
  treasuryId String
  type JournalTransactionType
  status JournalTransactionStatus @default(DRAFT)
  description String @db.VarChar(500)
  sourceType String? @db.VarChar(64)
  sourceId String? @db.VarChar(128)
  idempotencyKey String @db.VarChar(160)
  createdById String
  reversalOfId String?
  createdAt DateTime @default(now())
  postedAt DateTime?
  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  createdBy User @relation("JournalActor", fields: [createdById], references: [id], onDelete: Restrict)
  postings LedgerPosting[]
  reversalOf JournalTransaction? @relation("JournalReversals", fields: [reversalOfId, treasuryId], references: [id, treasuryId], onDelete: Restrict)
  reversals JournalTransaction? @relation("JournalReversals")
  @@unique([treasuryId, idempotencyKey])
  @@unique([id, treasuryId])
  @@unique([reversalOfId, treasuryId])
  @@index([treasuryId, status, postedAt])
  @@index([treasuryId, createdAt])
  @@index([sourceType, sourceId])
  @@map("journal_transactions")
}

model LedgerPosting {
  id String @id @default(cuid())
  treasuryId String
  journalTransactionId String
  accountId String
  side LedgerPostingSide
  amountMinor BigInt
  createdAt DateTime @default(now())
  journalTransaction JournalTransaction @relation(fields: [journalTransactionId, treasuryId], references: [id, treasuryId], onDelete: Restrict)
  account TreasuryAccount @relation(fields: [accountId, treasuryId], references: [id, treasuryId], onDelete: Restrict)
  @@index([treasuryId, accountId, createdAt])
  @@index([journalTransactionId])
  @@map("ledger_postings")
}

model Obligation {
  id String @id @default(cuid())
  treasuryId String
  memberId String
  sourceType ObligationSourceType
  sourceId String @db.VarChar(128)
  idempotencyKey String @db.VarChar(160)
  description String @db.VarChar(500)
  amountMinor BigInt
  status ObligationStatus @default(OPEN)
  dueAt DateTime?
  createdById String
  cancelledAt DateTime?
  cancellationReason String? @db.VarChar(300)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  member User @relation("ObligationMember", fields: [memberId], references: [id], onDelete: Restrict)
  createdBy User @relation("ObligationActor", fields: [createdById], references: [id], onDelete: Restrict)
  @@unique([treasuryId, idempotencyKey])
  @@unique([treasuryId, sourceType, sourceId])
  @@unique([id, treasuryId, memberId])
  @@index([treasuryId, status, dueAt])
  @@index([memberId, status])
  allocations ObligationAllocation[]
  financialCollections FinancialCollection[]
  contributionSnapshot ContributionAssessmentMember?
  @@map("obligations")
}

model PaymentReceipt {
  id String @id @default(cuid())
  treasuryId String
  memberId String
  source ReceiptSource @default(MANUAL_RECONCILIATION)
  amountMinor BigInt
  currency String @db.Char(3)
  externalReference String @db.VarChar(160)
  evidenceReference String @db.VarChar(500)
  idempotencyKey String @db.VarChar(160)
  receivedAt DateTime
  verifiedById String
  verifiedAt DateTime @default(now())
  createdAt DateTime @default(now())
  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  member User @relation("ReceiptMember", fields: [memberId], references: [id], onDelete: Restrict)
  verifiedBy User @relation("ReceiptVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  allocations ObligationAllocation[]
  providerSettlement FinancialSettlement?
  @@unique([treasuryId, externalReference])
  @@unique([treasuryId, idempotencyKey])
  @@unique([id, treasuryId, memberId])
  @@index([treasuryId, memberId, receivedAt])
  @@map("payment_receipts")
}

model ObligationAllocation {
  id String @id @default(cuid())
  treasuryId String
  memberId String
  receiptId String
  obligationId String
  amountMinor BigInt
  idempotencyKey String @db.VarChar(160)
  createdById String
  createdAt DateTime @default(now())
  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  receipt PaymentReceipt @relation(fields: [receiptId, treasuryId, memberId], references: [id, treasuryId, memberId], onDelete: Restrict)
  obligation Obligation @relation(fields: [obligationId, treasuryId, memberId], references: [id, treasuryId, memberId], onDelete: Restrict)
  createdBy User @relation("AllocationActor", fields: [createdById], references: [id], onDelete: Restrict)
  @@unique([treasuryId, idempotencyKey])
  @@unique([receiptId, obligationId])
  @@index([treasuryId, obligationId, createdAt])
  @@index([treasuryId, receiptId])
  @@map("obligation_allocations")
}

model FinancialAuditEvent {
  id String @id @default(cuid())
  treasuryId String
  actorId String
  action String @db.VarChar(80)
  entityType String @db.VarChar(80)
  entityId String @db.VarChar(128)
  reason String? @db.VarChar(500)
  metadata Json?
  createdAt DateTime @default(now())
  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  actor User @relation("FinancialAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([treasuryId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("financial_audit_events")
}




model FinancialProvider {
  id          String                  @id @default(cuid())
  code        String                  @unique @db.VarChar(64)
  displayName String                  @db.VarChar(120)
  status      FinancialProviderStatus @default(ACTIVE)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  collections FinancialCollection[]
  events      ProviderEvent[]

  @@index([status])
  @@map("financial_providers")
}

model FinancialCollection {
  id                   String                    @id @default(cuid())
  providerId           String
  treasuryId           String
  memberId             String
  obligationId         String?
  amountMinor          BigInt
  currency             String                    @db.Char(3)
  status               FinancialCollectionStatus @default(CREATED)
  idempotencyKey       String                    @db.VarChar(160)
  externalReference    String?                   @db.VarChar(160)
  providerCollectionId String?                   @db.VarChar(160)
  createdById          String
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  provider     FinancialProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  treasury     Treasury          @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  member       User              @relation("FinancialCollectionMember", fields: [memberId], references: [id], onDelete: Restrict)
  obligation   Obligation?       @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  createdBy    User              @relation("FinancialCollectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  events       ProviderEvent[]
  settlement   FinancialSettlement?
  reconciliations FinancialReconciliationRecord[]

  @@unique([treasuryId, idempotencyKey])
  @@unique([providerId, externalReference])
  @@unique([providerId, providerCollectionId])
  @@index([treasuryId, memberId, status, createdAt])
  @@index([obligationId])
  @@index([providerId, status, createdAt])
  @@map("financial_collections")
}

model ProviderEvent {
  id              String              @id @default(cuid())
  providerId      String
  collectionId    String?
  externalEventId String              @db.VarChar(160)
  eventType       String              @db.VarChar(120)
  status          ProviderEventStatus @default(RECEIVED)
  payload         Json
  receivedAt      DateTime            @default(now())
  validatedAt     DateTime?
  processedAt     DateTime?
  failureReason   String?             @db.VarChar(500)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  provider   FinancialProvider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  collection FinancialCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  settlement FinancialSettlement?

  @@unique([providerId, externalEventId])
  @@index([providerId, status, receivedAt])
  @@index([collectionId, receivedAt])
  @@map("provider_events")
}

model FinancialSettlement {
  id                String                   @id @default(cuid())
  collectionId      String                   @unique
  providerEventId   String                   @unique
  treasuryReceiptId String?                  @unique
  status            FinancialSettlementStatus @default(PENDING)
  amountMinor       BigInt
  currency          String                   @db.Char(3)
  idempotencyKey    String                   @db.VarChar(160)
  failureReason     String?                  @db.VarChar(500)
  settledAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  collection     FinancialCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  providerEvent  ProviderEvent       @relation(fields: [providerEventId], references: [id], onDelete: Restrict)
  treasuryReceipt PaymentReceipt?    @relation(fields: [treasuryReceiptId], references: [id], onDelete: Restrict)
  reconciliations FinancialReconciliationRecord[]

  @@unique([idempotencyKey])
  @@index([status, createdAt])
  @@map("financial_settlements")
}

model FinancialReconciliationRecord {
  id                  String                        @id @default(cuid())
  collectionId        String
  settlementId        String?
  status              FinancialReconciliationStatus @default(OPEN)
  expectedAmountMinor BigInt
  observedAmountMinor BigInt?
  currency            String                        @db.Char(3)
  reason              String?                       @db.VarChar(500)
  metadata            Json?
  createdAt           DateTime                      @default(now())
  resolvedAt          DateTime?
  updatedAt           DateTime                      @updatedAt

  collection FinancialCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  settlement FinancialSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([collectionId, createdAt])
  @@index([settlementId])
  @@map("financial_reconciliation_records")
}

model ContributionCampaign {
  id                   String                    @id @default(cuid())
  communityId          String
  name                 String                    @db.VarChar(140)
  description          String?                   @db.VarChar(500)
  amountMinor          BigInt
  frequency            ContributionFrequency
  assessmentGenerationMode ContributionAssessmentGenerationMode @default(MANUAL)
  status               ContributionCampaignStatus @default(ACTIVE)
  createdById          String
  pausedAt             DateTime?
  endedAt              DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  community          Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy          User      @relation("ContributionCampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assessments        ContributionAssessment[]
  events             ContributionCampaignEvent[]

  @@index([communityId, status, createdAt])
  @@map("contribution_campaigns")
}

model ContributionAssessment {
  id            String                       @id @default(cuid())
  campaignId    String
  communityId   String
  periodKey     String                       @db.VarChar(32)
  description   String                       @db.VarChar(500)
  amountMinor   BigInt
  currency      String                       @db.Char(3)
  dueAt         DateTime?
  status        ContributionAssessmentStatus @default(DRAFT)
  createdById   String
  issuedById    String?
  cancelledById String?
  issuedAt      DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  campaign   ContributionCampaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  community  Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy  User                       @relation("ContributionAssessmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  issuedBy   User?                      @relation("ContributionAssessmentIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  cancelledBy User?                     @relation("ContributionAssessmentCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  members    ContributionAssessmentMember[]

  @@unique([campaignId, periodKey])
  @@index([communityId, status, dueAt])
  @@index([campaignId, createdAt])
  @@map("contribution_assessments")
}

model ContributionAssessmentMember {
  id                  String              @id @default(cuid())
  assessmentId        String
  memberId            String
  memberRole          CommunityMemberRole
  memberJoinedAt      DateTime
  memberFirstName     String              @db.VarChar(80)
  memberLastName      String              @db.VarChar(80)
  memberEmail         String              @db.VarChar(320)
  snapshotAt          DateTime
  obligationId        String?             @unique
  createdAt           DateTime            @default(now())

  assessment ContributionAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  member     User                   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  obligation Obligation?            @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  assemblyCases AssemblyCase[]

  @@unique([assessmentId, memberId])
  @@index([assessmentId, snapshotAt])
  @@index([memberId, createdAt])
  @@map("contribution_assessment_members")
}


model ContributionCampaignEvent {
  id         String                        @id @default(cuid())
  campaignId String
  actorId    String
  type       ContributionCampaignEventType
  reason     String                        @db.VarChar(500)
  createdAt  DateTime                      @default(now())

  campaign ContributionCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  actor    User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([campaignId, createdAt])
  @@index([actorId, createdAt])
  @@map("contribution_campaign_events")
}

model AssemblyCase {
  id                 String             @id @default(cuid())
  communityId        String
  assessmentMemberId String
  requesterId        String
  reason             String             @db.VarChar(2000)
  status             AssemblyCaseStatus @default(SUBMITTED)
  submittedAt        DateTime           @default(now())
  withdrawnAt        DateTime?
  conflictReviewStartedAt DateTime?
  electorateFrozenAt DateTime?
  eligibleVoterCount Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  community        Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  assessmentMember ContributionAssessmentMember @relation(fields: [assessmentMemberId], references: [id], onDelete: Restrict)
  requester        User                       @relation("AssemblyCaseRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  events           AssemblyCaseEvent[]
  conflictDeclarations AssemblyConflictDeclaration[]
  electorate AssemblyCaseElectorateMember[]

  @@index([assessmentMemberId, status])
  @@index([communityId, status, submittedAt])
  @@index([requesterId, status, submittedAt])
  @@map("assembly_cases")
}

model AssemblyCaseEvent {
  id        String                 @id @default(cuid())
  caseId    String
  actorId   String
  type      AssemblyCaseEventType
  createdAt DateTime               @default(now())

  assemblyCase AssemblyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor        User         @relation("AssemblyCaseEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
  @@map("assembly_case_events")
}

model AssemblyConflictDeclaration {
  id String @id @default(cuid())
  caseId String
  declarantId String
  subjectUserId String
  reason String @db.VarChar(2000)
  subjectResponse String? @db.VarChar(2000)
  respondedAt DateTime?
  status AssemblyConflictDeclarationStatus @default(OPEN)
  createdAt DateTime @default(now())
  withdrawnAt DateTime?
  determinedAt DateTime?

  assemblyCase AssemblyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  declarant User @relation("AssemblyConflictDeclarant", fields: [declarantId], references: [id], onDelete: Restrict)
  subject User @relation("AssemblyConflictSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  decisions AssemblyConflictDecision[]

  @@index([caseId, status, createdAt])
  @@index([subjectUserId, status])
  @@map("assembly_conflict_declarations")
}

model AssemblyConflictDecision {
  id String @id @default(cuid())
  declarationId String
  reviewerId String
  conflictExists Boolean
  reason String @db.VarChar(1000)
  createdAt DateTime @default(now())

  declaration AssemblyConflictDeclaration @relation(fields: [declarationId], references: [id], onDelete: Restrict)
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([declarationId, reviewerId])
  @@index([declarationId, createdAt])
  @@map("assembly_conflict_decisions")
}

model AssemblyCaseElectorateMember {
  id String @id @default(cuid())
  caseId String
  userId String
  eligible Boolean
  exclusionReason String? @db.VarChar(80)
  createdAt DateTime @default(now())

  assemblyCase AssemblyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([caseId, userId])
  @@index([caseId, eligible])
  @@map("assembly_case_electorate_members")
}
