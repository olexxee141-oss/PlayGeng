generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum TreasuryAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}
enum JournalTransactionType {
  OPENING_BALANCE
  OBLIGATION_ISSUED
  PAYMENT_RECEIVED
  CONTRIBUTION_RECEIVED
  EXPENSE_PAID
  REFUND
  ADJUSTMENT
  REVERSAL
}
enum JournalTransactionStatus {
  DRAFT
  POSTED
}
enum LedgerPostingSide {
  DEBIT
  CREDIT
}
enum ObligationSourceType {
  CONTRIBUTION
  MATCH_FEE
  COMPETITION_FEE
  OTHER
}
enum ObligationStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CommunityStatus {
  ACTIVE
  ARCHIVED
}

enum MatchStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum MatchParticipantStatus {
  CONFIRMED
  WAITLISTED
  DECLINED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum CommunityMemberRole {
  CREATOR
  ADMIN
  TREASURER
  ORGANIZER
  MEMBER
}

enum ElectionRole {
  ADMIN
  TREASURER
  ORGANIZER
}

enum ElectionStatus {
  NOMINATIONS_OPEN
  NOMINATIONS_CLOSED
  VOTING_OPEN
  COMPLETED
  FAILED
  CANCELLED
}

enum Sport {
  FOOTBALL
  BASKETBALL
  VOLLEYBALL
  TENNIS
  TABLE_TENNIS
  BADMINTON
  CRICKET
  RUGBY
  ESPORTS
  OTHER
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum TeamMemberRole {
  CAPTAIN
  COACH
  PLAYER
}

enum CompetitionFormat {
  ROUND_ROBIN
  KNOCKOUT
}

enum CompetitionParticipantType {
  TEAM
  PLAYER
}

enum CompetitionRegistrationMode {
  OPEN
  APPROVAL_REQUIRED
  INVITE_ONLY
}

enum CompetitionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CompetitionEntryStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CompetitionInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique @db.VarChar(320)
  firstName                String                  @db.VarChar(80)
  lastName                 String                  @db.VarChar(80)
  passwordHash             String                  @db.VarChar(255)
  status                   UserStatus              @default(ACTIVE)
  emailVerifiedAt          DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  sessions                 AuthSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  communitiesOwned         Community[]            @relation("CommunityOwner")
  communityMemberships     CommunityMember[]
  createdMatches          Match[]                 @relation("MatchCreator")
  matchParticipations     MatchParticipant[]
  teamMemberships         TeamMember[]
  createdTeams            Team[]                 @relation("TeamCreator")
  createdCompetitions     Competition[]          @relation("CompetitionCreator")
  reviewedCompetitionEntries CompetitionEntry[]   @relation("CompetitionEntryReviewer")
  competitionEntries        CompetitionEntry[]   @relation("CompetitionPlayer")
  sentCompetitionInvitations CompetitionInvitation[] @relation("CompetitionInvitationSender")
  receivedCompetitionInvitations CompetitionInvitation[] @relation("CompetitionInvitationRecipient")
  invitedPlayerCompetitionInvitations CompetitionInvitation[] @relation("CompetitionInvitationPlayer")
  createdCommunityElections CommunityElection[] @relation("ElectionCreator")
  wonCommunityElections CommunityElection[] @relation("ElectionWinner")
  eligibleElectionVotes ElectionEligibleVoter[]
  electionNominations ElectionNomination[]
  electionBallots ElectionBallot[] @relation("ElectionVoter")
  createdTreasuries Treasury[] @relation("TreasuryCreator")
  createdJournalTransactions JournalTransaction[] @relation("JournalActor")
  createdObligations Obligation[] @relation("ObligationActor")
  memberObligations Obligation[] @relation("ObligationMember")
  financialAuditEvents FinancialAuditEvent[] @relation("FinancialAuditActor")

  @@index([status])
  @@map("users")
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique @db.VarChar(128)
  userAgent    String?   @db.VarChar(512)
  ipAddress    String?   @db.VarChar(64)
  expiresAt    DateTime
  lastUsedAt   DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique @db.VarChar(128)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique @db.VarChar(128)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Community {
  id          String          @id @default(cuid())
  name        String          @db.VarChar(120)
  slug        String          @unique @db.VarChar(140)
  description String?         @db.VarChar(1000)
  sport       String          @default("FOOTBALL") @db.VarChar(50)
  status      CommunityStatus @default(ACTIVE)
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner       User             @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     CommunityMember[]
  matches     Match[]
  sports      CommunitySport[]
  teams       Team[]
  competitions Competition[]
  competitionEntries CompetitionEntry[]
  competitionInvitations CompetitionInvitation[]
  elections CommunityElection[]
  treasury Treasury?

  @@index([ownerId])
  @@index([status])
  @@map("communities")
}

model CommunityMember {
  id          String              @id @default(cuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  community   Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  teamMemberships TeamMember[]
  @@index([userId])
  @@index([communityId, role])
  @@map("community_members")
}


model CommunitySport {
  id          String   @id @default(cuid())
  communityId String
  sport       Sport
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  teams     Team[]
  competitions Competition[]

  @@unique([communityId, sport])
  @@unique([id, communityId])
  @@index([communityId, isPrimary])
  @@map("community_sports")
}

model Team {
  id               String     @id @default(cuid())
  communityId      String
  communitySportId String
  name             String     @db.VarChar(100)
  shortName        String?    @db.VarChar(20)
  description      String?    @db.VarChar(500)
  status           TeamStatus @default(ACTIVE)
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User            @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sport     CommunitySport @relation(fields: [communitySportId, communityId], references: [id, communityId], onDelete: Restrict)
  members   TeamMember[]
  competitionEntries CompetitionEntry[]
  competitionInvitations CompetitionInvitation[]

  @@unique([id, communityId])
  @@unique([communityId, name])
  @@index([communityId, status])
  @@index([communitySportId, status])
  @@map("teams")
}

model TeamMember {
  id          String         @id @default(cuid())
  communityId String
  teamId      String
  userId      String
  role        TeamMemberRole @default(PLAYER)
  captainKey  String?        @db.VarChar(16)
  joinedAt    DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  team Team            @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Cascade)
  member CommunityMember @relation(fields: [communityId, userId], references: [communityId, userId], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([teamId, captainKey])
  @@index([communityId, userId])
  @@index([userId, joinedAt])
  @@map("team_members")
}


model Match {
  id          String       @id @default(cuid())
  communityId String
  createdById String
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(1000)
  sport       String       @db.VarChar(50)
  venue       String?      @db.VarChar(200)
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int?
  status      MatchStatus  @default(SCHEDULED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  community    Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("MatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants MatchParticipant[]

  @@index([communityId, startsAt])
  @@index([communityId, status, startsAt])
  @@index([createdById])
  @@map("matches")
}

model MatchParticipant {
  id        String                 @id @default(cuid())
  matchId   String
  userId    String
  status    MatchParticipantStatus @default(CONFIRMED)
  joinedAt  DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId, status])
  @@index([userId, joinedAt])
  @@map("match_participants")
}


model Competition {
  id                    String                       @id @default(cuid())
  communityId           String
  communitySportId      String
  createdById           String
  name                  String                       @db.VarChar(140)
  description           String?                      @db.VarChar(2000)
  format                CompetitionFormat
  participantType       CompetitionParticipantType
  registrationMode      CompetitionRegistrationMode  @default(APPROVAL_REQUIRED)
  status                CompetitionStatus            @default(DRAFT)
  maxEntries            Int?
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  startsAt              DateTime?
  rulesetVersion        String                       @default("1") @db.VarChar(32)
  adapterVersion        String                       @default("1") @db.VarChar(32)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  community       Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sport           CommunitySport @relation(fields: [communitySportId, communityId], references: [id, communityId], onDelete: Restrict)
  createdBy       User           @relation("CompetitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  entries         CompetitionEntry[]
  invitations     CompetitionInvitation[]

  @@unique([id, communityId])
  @@unique([id, communityId, participantType])
  @@index([communityId, status, startsAt])
  @@index([communitySportId, status])
  @@map("competitions")
}

model CompetitionEntry {
  id                    String                    @id @default(cuid())
  competitionId         String
  communityId           String
  participantType       CompetitionParticipantType
  teamId                String?
  playerUserId          String?
  status                CompetitionEntryStatus    @default(PENDING)
  participantNameSnapshot String                   @db.VarChar(160)
  registeredAt          DateTime                  @default(now())
  reviewedAt            DateTime?
  reviewedById          String?
  rejectionReason       String?                    @db.VarChar(500)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId, communityId, participantType], references: [id, communityId, participantType], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Restrict)
  player      User?       @relation("CompetitionPlayer", fields: [playerUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("CompetitionEntryReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([competitionId, status, registeredAt])
  @@index([communityId, playerUserId])
  @@map("competition_entries")
}


model CompetitionInvitation {
  id              String                      @id @default(cuid())
  competitionId   String
  communityId     String
  participantType CompetitionParticipantType
  teamId          String?
  playerUserId    String?
  invitedUserId   String
  invitedById     String
  status          CompetitionInvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId, communityId, participantType], references: [id, communityId, participantType], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId, communityId], references: [id, communityId], onDelete: Restrict)
  player      User?       @relation("CompetitionInvitationPlayer", fields: [playerUserId], references: [id], onDelete: Restrict)
  invitedUser User        @relation("CompetitionInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Restrict)
  invitedBy   User        @relation("CompetitionInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([competitionId, status, expiresAt])
  @@index([communityId, invitedUserId, status])
  @@map("competition_invitations")
}


model CommunityElection {
  id                 String         @id @default(cuid())
  communityId        String
  role               ElectionRole
  status             ElectionStatus @default(NOMINATIONS_OPEN)
  createdById        String
  nominationsCloseAt DateTime
  votingOpensAt      DateTime
  votingClosesAt     DateTime
  quorumPercent      Int
  eligibleVoterCount Int
  votesCast          Int            @default(0)
  winnerId           String?
  failureReason      String?        @db.VarChar(300)
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  community  Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy  User                  @relation("ElectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  winner     User?                 @relation("ElectionWinner", fields: [winnerId], references: [id], onDelete: Restrict)
  electorate ElectionEligibleVoter[]
  nominations ElectionNomination[]
  ballots    ElectionBallot[]

  @@index([communityId, status, role])
  @@index([communityId, createdAt])
  @@map("community_elections")
}

model ElectionEligibleVoter {
  id         String   @id @default(cuid())
  electionId String
  userId     String
  snapshotAt DateTime @default(now())

  election CommunityElection @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([electionId, userId])
  @@index([userId, electionId])
  @@map("election_eligible_voters")
}

model ElectionNomination {
  id          String    @id @default(cuid())
  electionId  String
  userId      String
  createdAt   DateTime  @default(now())
  withdrawnAt DateTime?

  election CommunityElection @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ballots  ElectionBallot[]

  @@unique([electionId, userId])
  @@unique([id, electionId])
  @@index([electionId, withdrawnAt])
  @@map("election_nominations")
}

model ElectionBallot {
  id          String   @id @default(cuid())
  electionId  String
  voterId     String
  candidateId String
  castAt      DateTime @default(now())

  election CommunityElection @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voter    User              @relation("ElectionVoter", fields: [voterId], references: [id], onDelete: Cascade)
  candidate ElectionNomination @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Cascade)

  @@unique([electionId, voterId])
  @@index([electionId, candidateId])
  @@map("election_ballots")
}


model Treasury {
  id          String   @id @default(cuid())
  communityId String   @unique
  createdById String
  currency    String   @db.Char(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  createdBy User @relation("TreasuryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  accounts TreasuryAccount[]
  journalTransactions JournalTransaction[]
  obligations Obligation[]
  auditEvents FinancialAuditEvent[]
  @@map("treasuries")
}

model TreasuryAccount {
  id String @id @default(cuid())
  treasuryId String
  code String @db.VarChar(32)
  name String @db.VarChar(100)
  type TreasuryAccountType
  isSystem Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  postings LedgerPosting[]
  @@unique([treasuryId, code])
  @@unique([id, treasuryId])
  @@index([treasuryId, type, isActive])
  @@map("treasury_accounts")
}

model JournalTransaction {
  id String @id @default(cuid())
  treasuryId String
  type JournalTransactionType
  status JournalTransactionStatus @default(DRAFT)
  description String @db.VarChar(500)
  sourceType String? @db.VarChar(64)
  sourceId String? @db.VarChar(128)
  idempotencyKey String @db.VarChar(160)
  createdById String
  reversalOfId String? @unique
  createdAt DateTime @default(now())
  postedAt DateTime?
  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  createdBy User @relation("JournalActor", fields: [createdById], references: [id], onDelete: Restrict)
  postings LedgerPosting[]
  reversalOf JournalTransaction? @relation("JournalReversals", fields: [reversalOfId, treasuryId], references: [id, treasuryId], onDelete: Restrict)
  reversals JournalTransaction? @relation("JournalReversals")
  @@unique([treasuryId, idempotencyKey])
  @@unique([id, treasuryId])
  @@index([treasuryId, status, postedAt])
  @@index([treasuryId, createdAt])
  @@index([sourceType, sourceId])
  @@map("journal_transactions")
}

model LedgerPosting {
  id String @id @default(cuid())
  treasuryId String
  journalTransactionId String
  accountId String
  side LedgerPostingSide
  amountMinor BigInt
  createdAt DateTime @default(now())
  journalTransaction JournalTransaction @relation(fields: [journalTransactionId, treasuryId], references: [id, treasuryId], onDelete: Restrict)
  account TreasuryAccount @relation(fields: [accountId, treasuryId], references: [id, treasuryId], onDelete: Restrict)
  @@index([treasuryId, accountId, createdAt])
  @@index([journalTransactionId])
  @@map("ledger_postings")
}

model Obligation {
  id String @id @default(cuid())
  treasuryId String
  memberId String
  sourceType ObligationSourceType
  sourceId String @db.VarChar(128)
  idempotencyKey String @db.VarChar(160)
  description String @db.VarChar(500)
  amountMinor BigInt
  status ObligationStatus @default(OPEN)
  dueAt DateTime?
  createdById String
  cancelledAt DateTime?
  cancellationReason String? @db.VarChar(300)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  member User @relation("ObligationMember", fields: [memberId], references: [id], onDelete: Restrict)
  createdBy User @relation("ObligationActor", fields: [createdById], references: [id], onDelete: Restrict)
  @@unique([treasuryId, idempotencyKey])
  @@unique([treasuryId, sourceType, sourceId])
  @@index([treasuryId, status, dueAt])
  @@index([memberId, status])
  @@map("obligations")
}

model FinancialAuditEvent {
  id String @id @default(cuid())
  treasuryId String
  actorId String
  action String @db.VarChar(80)
  entityType String @db.VarChar(80)
  entityId String @db.VarChar(128)
  reason String? @db.VarChar(500)
  metadata Json?
  createdAt DateTime @default(now())
  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  actor User @relation("FinancialAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([treasuryId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("financial_audit_events")
}
