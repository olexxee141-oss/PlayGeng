# Application
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000/api/v1

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/playgeng?schema=public

# Authentication (generate strong random values before deployment)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Logging
LOG_LEVEL=debug

# Payments - configured when the payment phase begins
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Email - configured when notification delivery is implemented
RESEND_API_KEY=
EMAIL_FROM=
