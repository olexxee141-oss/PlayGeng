# Application
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/playgeng?schema=public
# Optional direct connection used by Prisma migrations (defaults to DATABASE_URL)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/playgeng?schema=public

# Local PostgreSQL Docker service
POSTGRES_DB=playgeng
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Authentication (use a unique random secret of at least 32 characters in production)
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Email
RESEND_API_KEY=
EMAIL_FROM=PlayGeng <onboarding@resend.dev>

# Logging
LOG_LEVEL=debug

# Payments - configured when the payment phase begins
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
