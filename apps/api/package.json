{
  "name": "@playgeng/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/shared/utils/crypto.test.ts src/shared/authorization/community-permissions.test.ts src/modules/governance/governance.policy.test.ts src/modules/assembly/assembly.policy.test.ts src/modules/governance/governance.integration.test.ts src/modules/treasury/treasury.integration.test.ts src/modules/treasury/obligations.integration.test.ts src/modules/treasury/receipts.integration.test.ts src/modules/matches/matches.validator.test.ts src/modules/teams/teams.validator.test.ts src/modules/competitions/competitions.validator.test.ts src/modules/competitions/competitions.service.test.ts src/modules/competitions/competitions.integration.test.ts src/modules/competitions/competition-invitations.validator.test.ts src/modules/competitions/competition-invitations.integration.test.ts src/modules/sports/sport-capabilities.test.ts src/modules/contributions/contributions.validator.test.ts src/modules/contributions/contributions.integration.test.ts src/modules/financial-service/financial-service.integration.test.ts ../../packages/shared/src/competition-scheduling.test.ts",
    "dev:scheduler": "tsx watch src/workers/contribution-scheduler.ts",
    "start:scheduler": "node dist/workers/contribution-scheduler.js"
  },
  "dependencies": {
    "@playgeng/database": "0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.2.1",
    "jose": "^6.1.3",
    "zod": "^4.1.12",
    "pino": "^10.1.0",
    "@playgeng/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^26.0.0",
    "tsx": "^4.20.6",
    "pino-pretty": "^13.1.2"
  }
}
